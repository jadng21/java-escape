<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #FF1493; -fx-background-radius: 20px;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.escape.QuizViewController">
   <children>
      <Label fx:id="labelScore" alignment="CENTER_RIGHT" layoutX="550.0" layoutY="20.0" prefWidth="100.0" style="-fx-font-weight: bold; -fx-text-fill: white;" text="0 / 5">
         <font>
            <Font size="18.0" />
         </font>
      </Label>

      <Label fx:id="labelQuestion" alignment="CENTER" layoutX="50.0" layoutY="60.0" prefHeight="120.0" prefWidth="600.0" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 15px; -fx-padding: 20px; -fx-text-fill: #AD1457; -fx-font-weight: bold;" text="Chargement de la question..." wrapText="true">
         <font>
            <Font size="16.0" />
         </font>
      </Label>

      <Button fx:id="opt1" layoutX="50.0" layoutY="210.0" onAction="#opt1clicked" prefHeight="60.0" prefWidth="280.0" style="-fx-background-color: white; -fx-text-fill: #FF1493; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="Option 1" wrapText="true">
         <font>
            <Font size="14.0" />
         </font>
      </Button>

      <Button fx:id="opt2" layoutX="370.0" layoutY="210.0" onAction="#opt2clicked" prefHeight="60.0" prefWidth="280.0" style="-fx-background-color: white; -fx-text-fill: #FF1493; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="Option 2" wrapText="true">
         <font>
            <Font size="14.0" />
         </font>
      </Button>

      <Button fx:id="opt3" layoutX="50.0" layoutY="290.0" onAction="#opt3clicked" prefHeight="60.0" prefWidth="280.0" style="-fx-background-color: white; -fx-text-fill: #FF1493; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="Option 3" wrapText="true">
         <font>
            <Font size="14.0" />
         </font>
      </Button>

      <Button fx:id="opt4" layoutX="370.0" layoutY="290.0" onAction="#opt4clicked" prefHeight="60.0" prefWidth="280.0" style="-fx-background-color: white; -fx-text-fill: #FF1493; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="Option 4" wrapText="true">
         <font>
            <Font size="14.0" />
         </font>
      </Button>

      <Label fx:id="labelFeedback" alignment="CENTER" layoutX="50.0" layoutY="370.0" prefWidth="600.0" style="-fx-font-weight: bold; -fx-text-fill: white;" text="">
         <font>
            <Font size="16.0" />
         </font>
      </Label>

      <Button fx:id="btnNext" layoutX="280.0" layoutY="415.0" onAction="#onNext" prefHeight="45.0" prefWidth="140.0" style="-fx-background-color: #880E4F; -fx-text-fill: white; -fx-background-radius: 20px; -fx-font-weight: bold; -fx-cursor: hand;" text="SUIVANT" visible="false">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>